# PostgreSQL (required — set in application-local.yml or env)
# brew services start postgresql@16
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ibfarms
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Cloudinary (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

PORT=10000

# Render sets DATABASE_URL automatically when Postgres is linked.
# Or set SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/ibfarms
